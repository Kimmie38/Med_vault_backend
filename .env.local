# Copy to .env and fill in.
PORT=4000
NODE_ENV=development


JWT_SECRET=secretkeyinitiaatedbyuserknownasme
JWT_EXPIRES_IN=7d

APP_TIMEZONE=Africa/Lagos

CORS_ORIGIN=*

PASSWORD_MIN_LENGTH=6
BCRYPT_ROUNDS=10


ALERT_CRON=0 6 * * *
ENABLE_CRON=true

PUSH_ENABLED=true



ADMIN_EMAIL=admin@medvault.app
ADMIN_PASSWORD=AdminPassword@123
ADMIN_NAME=MedVault Administrator in
ADMIN_ID=ADMIN-001

ACTIVITY_RETENTION_DAYS=731
