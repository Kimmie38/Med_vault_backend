# Copy to .env and fill in.
PORT=4000
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas connection string (mongodb+srv://user:pass@cluster/medvault)
MONGODB_URI=mongodb+srv://kimrwang9_db_user:keepout8888@cluster0.gvzyqhi.mongodb.net/medvault?retryWrites=true&w=majority

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=secretkeyinitiaatedbyuserknownasme
JWT_EXPIRES_IN=7d

# Day boundaries (today, days to expiry, weekly sales) use this time zone
APP_TIMEZONE=Africa/Lagos

# Comma-separated list of allowed web origins, or * (the mobile app does not need CORS)
CORS_ORIGIN=*

PASSWORD_MIN_LENGTH=6
BCRYPT_ROUNDS=10


ALERT_CRON=0 6 * * *
ENABLE_CRON=true

PUSH_ENABLED=true



ADMIN_EMAIL=admin@medvault.app
ADMIN_PASSWORD=AdminPassword@123
ADMIN_NAME=MedVault Administrator in
ADMIN_ID=ADMIN-001

ACTIVITY_RETENTION_DAYS=731
