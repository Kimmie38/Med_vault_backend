# Copy to .env and fill in.
PORT=4000
NODE_ENV=development

# Local MongoDB, or a MongoDB Atlas connection string (mongodb+srv://user:pass@cluster/medvault)
MONGODB_URI=mongodb+srv://kimrwang9_db_user:keepout8888@cluster0.gvzyqhi.mongodb.net/medvault?retryWrites=true&w=majority

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=secretkeyinitiaatedbyuserknownasme
JWT_EXPIRES_IN=7d

# Day boundaries (today, days to expiry, weekly sales) use this time zone
APP_TIMEZONE=Africa/Lagos

# Comma-separated list of allowed web origins, or * (the mobile app does not need CORS)
CORS_ORIGIN=*

PASSWORD_MIN_LENGTH=6
BCRYPT_ROUNDS=10

# Daily job that re-checks expiry tiers (cron syntax, in APP_TIMEZONE)
ALERT_CRON=0 6 * * *
ENABLE_CRON=true

# Expo push notifications (optional access token for enhanced security)
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# ---- Administrator -------------------------------------------------------------------------------
# There is exactly ONE administrator. If none exists when the server starts, it is created from these two values
# (an existing admin is never replaced). Alternative: leave them empty and run `npm run create-admin` on the server.
# Password: at least 10 characters with upper case, lower case and a number. Remove ADMIN_PASSWORD after the first start.
ADMIN_EMAIL=admin@medvault.app
ADMIN_PASSWORD=AdminPassword@123
ADMIN_NAME=MedVault Administrator in
ADMIN_ID=ADMIN-001

# How long the admin activity log is kept (older entries are deleted automatically)
ACTIVITY_RETENTION_DAYS=731
